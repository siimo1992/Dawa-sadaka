/* الإجراءات على المنشورات */
$('#feed').addEventListener('click',async e=>{
  const b=e.target.closest('[data-a]');if(!b)return;
  const el=b.closest('.card'),id=+el.dataset.id,p=posts.find(x=>x.id===id),a=b.dataset.a;
  if(!p)return;
  if(a==='like'){S.liked.has(id)?S.liked.delete(id):S.liked.add(id);render()}
  else if(a==='cmt'){
    S.open.has(id)?S.open.delete(id):S.open.add(id);render();
    const f=document.querySelector('.card[data-id="'+id+'"] .cform input');if(f)f.focus();
  }else if(a==='menu')openMenu(b,p);
  else if(a==='esave'){
    const t=el.querySelector('.etxt').value.trim();
    if(t.length<5){toast('اكتب نص الخبر أولًا');return}
    p.text=t;p.edited=true;S.edit=null;render();toast('تم حفظ التعديل');
  }else if(a==='ecancel'){S.edit=null;render()}
  else if(a==='share'){
    const text=p.text.slice(0,230)+(p.source?'\nالمصدر: '+p.source:'');
    try{
      if(navigator.share)await navigator.share({title:'من محليات',text});
      else if(navigator.clipboard){await navigator.clipboard.writeText(text);toast('نُسخ الخبر')}
    }catch(_){}
  }else if(a==='flag')toast('تم تسجيل البلاغ (معاينة)');
});
$('#feed').addEventListener('submit',e=>{
  e.preventDefault();
  if(U(ME).banned){toast('حسابك محظور من التعليق');return}
  const el=e.target.closest('.card'),p=posts.find(x=>x.id===+el.dataset.id),t=e.target.querySelector('input').value.trim();
  if(!t)return;
  p.comments.push('أنت: '+t);render();
});

/* النشر */
const comp=$('#comp');
function openComp(){comp.classList.add('open');$('#txt').focus({preventScroll:true});comp.scrollIntoView({behavior:'smooth',block:'center'})}
$('#prompt').onclick=openComp;$('#fab').onclick=openComp;
$('#attach').onclick=()=>$('#file').click();
$('#file').addEventListener('change',e=>{
  const f=e.target.files[0];if(!f)return;
  S.file=f;$('#fname').textContent=f.name;$('#fchip').classList.add('show');
});
$('#fx').onclick=()=>{S.file=null;$('#file').value='';$('#fchip').classList.remove('show')};
$('#pub').onclick=()=>{
  if(U(ME).banned){toast('حسابك محظور من النشر');return}
  const text=$('#txt').value.trim();
  if(text.length<5){toast('اكتب نص الخبر أولًا');$('#txt').focus();return}
  posts.unshift({id:Date.now(),uid:ME,cat:$('#cat').value,place:$('#place').value.trim()||S.loc,ts:Date.now(),likes:0,
    review:S.admin?0:1,text,source:$('#src').value.trim(),comments:[],
    media:S.file?{url:URL.createObjectURL(S.file),video:S.file.type.startsWith('video')}:null});
  ['#txt','#place','#src'].forEach(s=>$(s).value='');
  $('#fx').click();comp.classList.remove('open');
  S.cat='all';S.sort='new';document.querySelectorAll('#chips .chip').forEach(c=>c.setAttribute('aria-pressed',c.dataset.c==='all'));
  refresh();toast(S.admin?'تم نشر المنشور':'وصل منشورك للمراجعة');
};

/* لوحة التحكم */
function usersHtml(){
  return users.filter(u=>u.id!==ME).map(u=>{
    const n=posts.filter(p=>p.uid===u.id).length;
    return '<div class="urow" data-u="'+u.id+'"><span class="av'+(u.verified?' off':'')+'" aria-hidden="true">'+esc(u.name.charAt(0))+'</span>'+
      '<div class="who"><div class="line">'+esc(u.name)+(u.verified?BADGE:'')+(u.banned?'<span class="pill ban">محظور</span>':'')+'</div><div class="meta">'+n+(n===1?' منشور':' منشورات')+'</div></div>'+
      '<button class="tgl vf" type="button" data-t="verify" aria-pressed="'+!!u.verified+'" title="'+(u.verified?'نزع التوثيق':'منح التوثيق')+'" aria-label="'+(u.verified?'نزع علامة التوثيق':'منح علامة التوثيق')+'">'+ic('shieldok')+'</button>'+
      '<button class="tgl bn" type="button" data-t="ban" aria-pressed="'+!!u.banned+'" title="'+(u.banned?'إلغاء الحظر':'حظر')+'" aria-label="'+(u.banned?'إلغاء الحظر':'حظر الناشر')+'">'+ic('ban')+'</button>'+
      '<button class="tgl dl" type="button" data-t="purge" title="حذف كل منشوراته" aria-label="حذف كل منشوراته">'+ic('trash')+'</button></div>';
  }).join('');
}
function queueHtml(pend){
  if(!pend.length)return '<div class="empty">'+ic('check')+'<div>لا شيء بانتظار المراجعة</div></div>';
  return pend.map(p=>{
    const u=U(p.uid);
    return '<div class="q-item" data-p="'+p.id+'"><div class="line">'+esc(u.name)+(u.verified?BADGE:'')+'<span class="meta" style="font-weight:500">'+ago(p.ts)+'</span></div><p>'+esc(p.text)+'</p>'+
      '<div class="q-acts"><button type="button" class="ap" data-t="ap">'+ic('check',16)+'اعتماد</button><button type="button" data-t="rj">'+ic('x',16)+'رفض</button></div></div>';
  }).join('');
}
function renderAdmin(){
  const pend=posts.filter(p=>p.review),nb=users.filter(u=>u.banned).length;
  $('#stats').innerHTML=
    '<div class="stat">'+ic('news')+'<b>'+posts.length+'</b><span class="sr">المنشورات</span></div>'+
    '<div class="stat">'+ic('clock')+'<b>'+pend.length+'</b><span class="sr">بانتظار المراجعة</span></div>'+
    '<div class="stat">'+ic('ban')+'<b>'+nb+'</b><span class="sr">المحظورون</span></div>';
  $('#aTabs').innerHTML=
    '<button class="chip" type="button" data-k="users" aria-pressed="'+(S.tab==='users')+'">'+ic('users')+'الناشرون</button>'+
    '<button class="chip" type="button" data-k="queue" aria-pressed="'+(S.tab==='queue')+'">'+ic('clock')+'المراجعة '+pend.length+'</button>';
  $('#aBody').innerHTML=S.tab==='users'?usersHtml():queueHtml(pend);
}
$('#aTabs').addEventListener('click',e=>{const b=e.target.closest('[data-k]');if(!b)return;S.tab=b.dataset.k;renderAdmin()});
$('#aBody').addEventListener('click',e=>{
  const b=e.target.closest('[data-t]');if(!b)return;
  const t=b.dataset.t,row=b.closest('[data-u]'),q=b.closest('[data-p]');
  if(row){
    const u=U(row.dataset.u);
    if(t==='verify')verify(u);else if(t==='ban')ban(u);else if(t==='purge')purge(u);
  }else if(q){
    const p=posts.find(x=>x.id===+q.dataset.p);if(!p)return;
    if(t==='ap'){p.review=0;refresh();toast('تم اعتماد المنشور')}
    else if(t==='rj'){posts=posts.filter(x=>x!==p);refresh();toast('تم رفض المنشور')}
  }
});
$('#pBtn').onclick=()=>{renderAdmin();$('#adm').showModal()};
$('#aClose').onclick=()=>$('#adm').close();
$('#cNo').onclick=()=>$('#cdlg').close();

