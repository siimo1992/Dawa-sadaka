const S={cat:'all',q:'',sort:'new',open:new Set(),liked:new Set(),file:null,admin:false,edit:null,tab:'users',loc:''};

/* الصلاحيات في الواجهة للعرض فقط. الخادم هو من يقرر ويتحقق من كل عملية */
const canEdit=p=>p.uid===ME&&!U(ME).banned;
const canMenu=p=>S.admin||p.uid===ME;
const visible=p=>{
  if(S.admin)return true;
  if(U(p.uid).banned)return false;
  if(p.review&&p.uid!==ME)return false;
  return true;
};

function ago(ts){
  const m=Math.round((Date.now()-ts)/6e4);
  if(m<1)return 'الآن';
  if(m<60)return 'قبل '+m+(m<=10?' دقائق':' دقيقة');
  const h=Math.round(m/60);
  if(h<24)return h===1?'قبل ساعة':h===2?'قبل ساعتين':'قبل '+h+(h<=10?' ساعات':' ساعة');
  if(h<48)return 'أمس';
  return new Date(ts).toLocaleDateString('ar-DZ',{day:'numeric',month:'short'});
}
function srcHtml(s){
  if(!s)return '';
  const link=/^https?:\/\/\S+$/i.test(s)?'<a href="'+esc(s)+'" target="_blank" rel="noopener noreferrer">'+esc(s)+'</a>':esc(s);
  return '<div class="src">'+ic('link',16)+'<span>'+link+'</span></div>';
}
function card(p){
  const c=CATS[p.cat],u=U(p.uid),liked=S.liked.has(p.id),open=S.open.has(p.id),ed=S.edit===p.id;
  return '<article class="card'+(u.banned?' banned':'')+'" data-id="'+p.id+'">'+
   '<div class="head"><span class="av'+(u.verified?' off':'')+'" aria-hidden="true">'+esc(u.name.charAt(0))+'</span>'+
   '<div class="who"><div class="line">'+esc(u.name)+(u.verified?BADGE:'')+
   (p.demo?'<span class="pill">تجريبي</span>':'')+(p.review?'<span class="pill rev">قيد المراجعة</span>':'')+(u.banned?'<span class="pill ban">محظور</span>':'')+'</div>'+
   '<div class="meta">'+ago(p.ts)+(p.edited?' · عُدّل':'')+(p.place?' · '+esc(p.place):'')+'</div></div>'+
   '<span class="cat">'+ic(c[0])+c[1]+'</span>'+
   (canMenu(p)?'<button class="menu-btn" type="button" data-a="menu" aria-haspopup="menu" aria-label="خيارات المنشور">'+ic('dots')+'</button>':'')+'</div>'+
   (ed?'<div class="editbox"><textarea class="etxt" maxlength="600" aria-label="تعديل المنشور">'+esc(p.text)+'</textarea><div class="q-acts"><button type="button" class="ap" data-a="esave">'+ic('check',16)+'حفظ</button><button type="button" data-a="ecancel">'+ic('x',16)+'إلغاء</button></div></div>'
      :'<p class="txt">'+esc(p.text)+'</p>')+
   (p.media?(p.media.video?'<video class="media" controls src="'+p.media.url+'"></video>':'<img class="media" alt="" src="'+p.media.url+'">'):'')+
   srcHtml(p.source)+
   '<div class="acts">'+
   '<button class="act" type="button" data-a="like" aria-pressed="'+liked+'" aria-label="مفيد">'+ic('thumb')+(p.likes+(liked?1:0))+'</button>'+
   '<button class="act" type="button" data-a="cmt" aria-pressed="'+open+'" aria-label="التعليقات">'+ic('chat')+p.comments.length+'</button>'+
   '<button class="act" type="button" data-a="share" aria-label="مشاركة">'+ic('share')+'</button>'+
   '<button class="act end" type="button" data-a="flag" aria-label="إبلاغ">'+ic('flag')+'</button></div>'+
   (open?'<div class="cmts">'+p.comments.map(t=>'<div class="cmt">'+esc(t)+'</div>').join('')+
     '<form class="cform"><input aria-label="اكتب تعليقًا" placeholder="اكتب تعليقًا" maxlength="240" required><button type="submit" aria-label="إرسال">'+ic('send')+'</button></form></div>':'')+
   '</article>';
}
function render(){
  closePop();
  const q=S.q.toLowerCase();
  const likes=p=>p.likes+(S.liked.has(p.id)?1:0);
  const list=posts.filter(p=>visible(p)&&(S.cat==='all'||p.cat===S.cat)&&(!q||(p.text+' '+U(p.uid).name+' '+p.place+' '+(p.source||'')).toLowerCase().includes(q)))
    .sort((a,b)=>S.sort==='new'?b.ts-a.ts:likes(b)-likes(a));
  $('#count').innerHTML=ic('news',16)+list.length+(list.length===1?' منشور':' منشورات');
  $('#sort').innerHTML=S.sort==='new'?ic('clock',16)+'الأحدث':ic('thumb',16)+'الأكثر نفعًا';
  $('#feed').innerHTML=list.length?list.map(card).join(''):'<div class="empty">'+ic('search')+'<div>لا توجد منشورات مطابقة</div></div>';
}
function refresh(){render();if($('#adm').open)renderAdmin()}
function toast(m){const e=$('#toast');e.textContent=m;e.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('show'),2300)}
function ask(t,m,ok,fn){
  $('#cT').textContent=t;$('#cM').textContent=m;$('#cOk').textContent=ok;
  $('#cOk').onclick=()=>{$('#cdlg').close();fn()};
  $('#cdlg').showModal();
}

/* إجراءات الإدارة (مشتركة بين القائمة واللوحة) */
function verify(u){u.verified=!u.verified;refresh();toast(u.verified?'مُنحت علامة التوثيق لـ '+u.name:'نُزعت علامة التوثيق من '+u.name)}
function ban(u){
  if(u.banned){u.banned=false;refresh();toast('أُلغي حظر '+u.name);return}
  ask('حظر '+u.name,'ستُخفى كل منشوراته، ولن يستطيع النشر أو التعليق.','حظر',()=>{u.banned=true;refresh();toast('تم حظر '+u.name)});
}
function purge(u){
  ask('حذف منشورات '+u.name,'ستُحذف كل منشوراته نهائيًا.','حذف الكل',()=>{posts=posts.filter(p=>p.uid!==u.id);refresh();toast('حُذفت منشورات '+u.name)});
}
function act(p,m){
  const u=U(p.uid);
  if(m==='edit'){
    S.edit=p.id;render();
    const t=document.querySelector('.card[data-id="'+p.id+'"] .etxt');
    if(t){t.focus();t.setSelectionRange(t.value.length,t.value.length)}
  }else if(m==='del')ask('حذف المنشور','سيُحذف هذا المنشور نهائيًا.','حذف',()=>{posts=posts.filter(x=>x!==p);S.open.delete(p.id);refresh();toast('تم حذف المنشور')});
  else if(m==='ok'){p.review=0;refresh();toast('تم اعتماد المنشور')}
  else if(m==='verify')verify(u);
  else if(m==='ban')ban(u);
}

/* قائمة ⋯ على المنشور */
const pop=document.createElement('div');
pop.className='pop';pop.setAttribute('role','menu');document.body.appendChild(pop);
let popP=null;
function closePop(){pop.classList.remove('show');popP=null}
function openMenu(btn,p){
  if(popP===p){closePop();return}
  const u=U(p.uid),it=[],mine=canEdit(p),adm=[];
  if(mine)it.push(['edit','edit','تعديل المنشور']);
  if(mine||S.admin)it.push(['del','trash','حذف المنشور',1]);
  if(S.admin){
    if(p.review)adm.push(['ok','check','اعتماد النشر']);
    if(p.uid!==ME){
      adm.push(['verify','shieldok',u.verified?'نزع علامة التوثيق':'منح علامة التوثيق']);
      adm.push(['ban','ban',u.banned?'إلغاء حظر الناشر':'حظر الناشر',!u.banned]);
    }
  }
  if(adm.length){it.push(['lbl']);adm.forEach(x=>it.push(x))}
  if(!it.length)return;
  pop.innerHTML=it.map(x=>x[0]==='lbl'?'<hr><div class="lbl">'+ic('shieldok',14)+'صلاحيات المشرف</div>'
    :'<button type="button" role="menuitem" data-m="'+x[0]+'"'+(x[3]?' class="danger"':'')+'>'+ic(x[1])+x[2]+'</button>').join('');
  pop.classList.add('show');popP=p;
  const r=btn.getBoundingClientRect(),w=pop.offsetWidth,h=pop.offsetHeight;
  const l=Math.min(Math.max(8,r.left),innerWidth-w-8);
  let t=r.bottom+4;
  if(t+h>innerHeight-8)t=Math.max(8,r.top-h-4);
  pop.style.left=l+'px';pop.style.top=t+'px';
}
pop.addEventListener('click',e=>{
  const b=e.target.closest('[data-m]');if(!b||!popP)return;
  const p=popP;closePop();act(p,b.dataset.m);
});
document.addEventListener('click',e=>{if(!e.target.closest('.pop')&&!e.target.closest('[data-a="menu"]'))closePop()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closePop()});
addEventListener('scroll',closePop,{passive:true});

