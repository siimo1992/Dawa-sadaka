function setLoc(t){S.loc=t;$('#locT').textContent=t;$('#prompt').textContent='شارك خبرًا مع أهل '+t}
function fallbackCountry(){
  try{
    if(Intl.DateTimeFormat().resolvedOptions().timeZone==='Africa/Algiers')return 'الجزائر';
    const r=(navigator.language||'').split('-')[1];
    if(r)return new Intl.DisplayNames(['ar'],{type:'region'}).of(r.toUpperCase());
  }catch(_){}
  return 'الجزائر';
}
const cleanName=n=>String(n||'').replace(/^ولاية\s+/,'').replace(/^(Wilaya|Province) of\s+/i,'').replace(/\s+(Province|Wilaya)$/i,'').trim();
function detect(manual){
  if(!manual){
    try{const c=JSON.parse(localStorage.getItem(LOCK)||'null');if(c&&Date.now()-c.t<864e5){setLoc(c.v);return}}catch(_){}
  }
  if(!S.loc)setLoc(fallbackCountry());
  if(!navigator.geolocation){if(manual)toast('المتصفح لا يدعم تحديد الموقع');return}
  if(manual)$('#locT').textContent='جارٍ التحديد…';
  navigator.geolocation.getCurrentPosition(async pos=>{
    try{
      const r=await fetch('https://api.bigdatacloud.net/data/reverse-geocode-client?latitude='+pos.coords.latitude+'&longitude='+pos.coords.longitude+'&localityLanguage=ar');
      const d=await r.json();
      const name=cleanName(d.countryCode==='DZ'?d.principalSubdivision:d.countryName);
      if(!name)throw 0;
      setLoc(name);
      try{localStorage.setItem(LOCK,JSON.stringify({v:name,t:Date.now()}))}catch(_){}
    }catch(_){setLoc(S.loc);if(manual)toast('تعذّر معرفة موقعك، حاول لاحقًا')}
  },()=>{setLoc(S.loc);if(manual)toast('فعّل إذن الموقع من إعدادات المتصفح')},{timeout:9000,maximumAge:36e5});
}
$('#loc').onclick=()=>detect(true);
detect(false);
render();
</script>
</body>
</html>
